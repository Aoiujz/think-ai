{
  "name": "@topthink/think-ai",
  "version": "1.0.1",
  "description": "Official ThinkAI SDK for TypeScript and JavaScript",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/top-think/think-ai.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"../scripts/**/*.mjs\" \"../tests/contracts/**/*.mjs\" \"../tests/release/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"../scripts/**/*.mjs\" \"../tests/contracts/**/*.mjs\" \"../tests/release/**/*.mjs\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
